# ==========================================================
# 容器内专用配置
# 用法：compose 把它挂载为容器里的 /app/.env
# 与宿主机 .env 的唯一区别：服务地址用 compose 服务名，路径用 Linux 容器路径
# ==========================================================

# ====================
# Model Source & Cache
# ====================
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
# 模型在容器内只读挂载；缓存目录写到容器内可写位置
MODELSCOPE_CACHE=/root/.cache/modelscope
HF_HOME=/root/.cache/huggingface

# ====================
# OpenAI / LLM API
# ====================
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.siliconflow.cn/v1
LLM_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Pro
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=Pro/moonshotai/Kimi-K2.6
ITEM_MODEL=deepseek-ai/DeepSeek-V4-Flash
MODEL=DS

# ====================
# BGE Embedding Models（挂载到 /models）
# ====================
BGE_M3_PATH=/models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=True
BGE_RERANKER_LARGE=/models/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=1

# ====================
# Embedding General
# ====================
EMBEDDING_DIM=1536

# ====================
# Vector Database (Milvus) —— compose 服务名 standalone
# ====================
MILVUS_URL=http://standalone:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# ====================
# Document Database (MongoDB) —— compose 服务名 mongo
# ====================
MONGO_URL=mongodb://mongo:27017
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO) —— compose 服务名 minio
# ====================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=/upload-images

# ====================
# Other / MCP Services
# ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_API_KEY=

# ====================
# 重排序模型
# ====================
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落

# ====================
# 数据根目录（挂载 D:\file -> /data/file）
# ====================
DATA_BASED_ROOT_DIR=/data/file

# ====================
# MINERU
# ====================
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=
